# Telegram
BOT_TOKEN=
# Comma-separated numeric user IDs (получить через @userinfobot)
ALLOWED_USERS=1041468382,285949691

# Database (Railway инжектит автоматически через ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# GitHub (для коммитов одобренного контента)
GITHUB_TOKEN=
GITHUB_CONTENT_REPO=rychagovantonv-cloud/wellness-content

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
ENV=prod

# Runtime (Railway инжектит PORT автоматически)
PORT=8080
